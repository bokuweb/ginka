#!/bin/sh
# Build Ginka.app and a .dmg holding it (RELEASING.md step 5).
#
#   scripts/package-macos                   # cargo build --release, then pack
#   scripts/package-macos --universal       # arm64 + x86_64, joined with lipo
#   scripts/package-macos --bin-dir DIR     # pack binaries built elsewhere
#   scripts/package-macos --no-dmg          # the .app only
#
# The window (built as `ginka`) is the bundle's executable, `ginka-app`; the
# command line (`ginka-cli`) ships as `ginka` and the daemon as
# `ginka-daemon`, all three in Contents/MacOS, where each finds the others
# (roadmap N16: the daemon is bundled and signed with the app).
#
# The workspace browser is Chromium: its framework goes in
# Contents/Frameworks, and `ginka-helper` goes beside it as the five
# `ginka-app Helper*.app` Chromium starts its processes from. `ginka-bundle`
# lays that out; it needs Chromium's distribution at CEF_PATH, where the
# first build downloads it.
#
# Signing: GINKA_SIGN_IDENTITY names a Developer ID certificate in the
# keychain; without it the bundle is signed ad hoc, which runs on this Mac
# and nowhere Gatekeeper is asked. GINKA_NOTARY_PROFILE names a
# `notarytool store-credentials` profile; with it the .dmg is notarized and
# stapled. GINKA_BUNDLE_ID overrides the bundle identifier.
set -eu

# Where Chromium's distribution lives; the first build downloads it there.
export CEF_PATH="${CEF_PATH:-$HOME/.local/share/cef}"

root=$(cd "$(dirname "$0")/.." && pwd)
bin_dir=""
out_dir="$root/target/package"
version=$(sed -n 's/^version = "\(.*\)"/\1/p' "$root/Cargo.toml" | head -n 1)
universal=false
dmg=true
bundle_id="${GINKA_BUNDLE_ID:-io.github.bokuweb.ginka}"

while [ $# -gt 0 ]; do
    case "$1" in
    --bin-dir) bin_dir="$2"; shift 2 ;;
    --out-dir) out_dir="$2"; shift 2 ;;
    --version) version="$2"; shift 2 ;;
    --universal) universal=true; shift ;;
    --no-dmg) dmg=false; shift ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done

packages="-p ginka -p ginka-cli -p ginka-daemon"
binaries="ginka ginka-helper ginka-cli ginka-daemon"
if [ -z "$bin_dir" ]; then
    if $universal; then
        for target in aarch64-apple-darwin x86_64-apple-darwin; do
            # shellcheck disable=SC2086
            (cd "$root" && cargo build --release --target "$target" $packages)
        done
        bin_dir="$root/target/universal-release"
        mkdir -p "$bin_dir"
        for binary in $binaries; do
            lipo -create \
                "$root/target/aarch64-apple-darwin/release/$binary" \
                "$root/target/x86_64-apple-darwin/release/$binary" \
                -output "$bin_dir/$binary"
        done
    else
        # shellcheck disable=SC2086
        (cd "$root" && cargo build --release $packages)
        bin_dir="$root/target/release"
    fi
fi

# Assembled and signed on the system volume: a disk without extended
# attributes (exFAT, most external drives) grows `._*` AppleDouble files
# beside anything copied onto it, and a bundle with those inside does not
# verify.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
stage="$work/macos"
app="$stage/Ginka.app"
mkdir -p "$stage" "$out_dir"

# The bundle tool runs here, whatever the binaries were built for.
(cd "$root" && cargo build -q -p ginka-bundle)
bundler="${CARGO_TARGET_DIR:-$root/target}/debug/ginka-bundle"
inputs="$work/inputs"
mkdir -p "$inputs"
cp "$bin_dir/ginka" "$inputs/ginka-app"
cp "$bin_dir/ginka-helper" "$inputs/ginka-helper"
built=$("$bundler" --binaries "$inputs" --out "$work/bundle" --executable ginka-app \
    --helper ginka-helper --identifier "$bundle_id" --version "$version")
mv "$built" "$app"
mkdir -p "$app/Contents/Resources"
cp "$bin_dir/ginka-cli" "$app/Contents/MacOS/ginka"
cp "$bin_dir/ginka-daemon" "$app/Contents/MacOS/ginka-daemon"
chmod 0755 "$app/Contents/MacOS/"*
sed -e "s|@BUNDLE_ID@|$bundle_id|" -e "s|@VERSION@|$version|" \
    "$root/packaging/macos/Info.plist.in" >"$app/Contents/Info.plist"
plutil -lint "$app/Contents/Info.plist" >/dev/null

# Inside out, the bundle last: signing a bundle seals what is in it. Under
# the hardened runtime Chromium's processes need JIT and the unsigned
# framework loaded, which the entitlements grant.
identity="${GINKA_SIGN_IDENTITY:--}"
entitlements="$root/packaging/macos/browser.entitlements"
sign() {
    if [ "$identity" = "-" ]; then
        codesign --force --sign - "$1"
    else
        codesign --force --options runtime --timestamp --entitlements "$entitlements" \
            --sign "$identity" "$1"
    fi
}
sign "$app/Contents/Frameworks/Chromium Embedded Framework.framework"
for helper in "$app/Contents/Frameworks/"*Helper*.app; do
    sign "$helper"
done
for tool in ginka ginka-daemon; do
    sign "$app/Contents/MacOS/$tool"
done
sign "$app"
codesign --verify --strict "$app"

if ! $dmg; then
    rm -rf "$out_dir/Ginka.app"
    ditto --norsrc --noextattr "$app" "$out_dir/Ginka.app"
    echo "$out_dir/Ginka.app"
    exit 0
fi

image="$out_dir/Ginka-$version.dmg"
ln -s /Applications "$stage/Applications"
rm -f "$image"
hdiutil create -quiet -volname Ginka -srcfolder "$stage" -ov -format UDZO "$work/Ginka.dmg"
cp "$work/Ginka.dmg" "$image"
if [ "$identity" != "-" ]; then
    codesign --force --timestamp --sign "$identity" "$image"
fi
if [ -n "${GINKA_NOTARY_PROFILE:-}" ]; then
    xcrun notarytool submit "$image" --keychain-profile "$GINKA_NOTARY_PROFILE" --wait
    xcrun stapler staple "$image"
fi
echo "$image"
