#!/bin/sh
# Run cargo against the sibling e1 checkout, without touching Cargo.lock.
#
#   scripts/cargo-local-e1 run --features github
#   E1=../elsewhere/e1 scripts/cargo-local-e1 check --features github
#
# A `[patch]` in .cargo/config.toml does the same but rewrites Cargo.lock to
# path dependencies on every build, and that lock must never be committed:
# CI and every other checkout resolve e1 by the rev pinned in Cargo.toml.
# This puts the committed lock back when cargo exits, however it exits.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
e1=$(cd "${E1:-$root/../e1}" && pwd)
lock="$root/Cargo.lock"
backup=$(mktemp)
cp "$lock" "$backup"
trap 'cp "$backup" "$lock"; rm -f "$backup"' EXIT INT TERM
source="patch.'https://github.com/bokuweb/e1'"
cargo \
  --config "$source.e1-github.path=\"$e1/crates/e1-github\"" \
  --config "$source.e1-ui.path=\"$e1/crates/e1-ui\"" \
  --config "$source.e1-views.path=\"$e1/crates/e1-views\"" \
  "$@"
