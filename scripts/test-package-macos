#!/bin/sh
# Pack stand-in binaries into Ginka.app and a .dmg, and check the bundle:
# where each binary landed, what Info.plist says, that the signature holds,
# and that the image is one hdiutil reads. macOS only.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

mkdir -p "$work/built"
for binary in ginka ginka-helper ginka-cli ginka-daemon; do
    printf '#!/bin/sh\necho %s\n' "$binary" >"$work/built/$binary"
    chmod +x "$work/built/$binary"
done

image=$(sh "$root/scripts/package-macos" --bin-dir "$work/built" --out-dir "$work/out" --version 9.9.9)
# The .app as it is inside the image.
mount=$(mktemp -d)
hdiutil attach -quiet -nobrowse -readonly -mountpoint "$mount" "$image"
trap 'hdiutil detach -quiet "$mount" 2>/dev/null; rm -rf "$work" "$mount"' EXIT
app="$mount/Ginka.app"
fail() { echo "FAIL: $1" >&2; exit 1; }

[ "$("$app/Contents/MacOS/ginka-app")" = "ginka" ] || fail "the bundle's executable is the window"
[ "$("$app/Contents/MacOS/ginka")" = "ginka-cli" ] || fail "ginka is the command line"
[ "$("$app/Contents/MacOS/ginka-daemon")" = "ginka-daemon" ] || fail "the daemon is bundled beside them"
# Chromium's framework, and its helper processes as apps of their own named
# after the executable, which is how it finds them.
[ -d "$app/Contents/Frameworks/Chromium Embedded Framework.framework" ] || fail "the browser's framework is bundled"
for kind in "" " (GPU)" " (Renderer)" " (Plugin)" " (Alerts)"; do
    helper="$app/Contents/Frameworks/ginka-app Helper$kind.app/Contents/MacOS/ginka-app Helper$kind"
    [ "$("$helper")" = "ginka-helper" ] || fail "ginka-app Helper$kind runs ginka-helper"
done
plist="$app/Contents/Info.plist"
[ "$(plutil -extract CFBundleExecutable raw "$plist")" = "ginka-app" ] || fail "CFBundleExecutable"
[ "$(plutil -extract CFBundleIdentifier raw "$plist")" = "io.github.bokuweb.ginka" ] || fail "CFBundleIdentifier"
[ "$(plutil -extract CFBundleShortVersionString raw "$plist")" = "9.9.9" ] || fail "the version"
codesign --verify --strict "$app" || fail "the signature holds"
case "$image" in
*/Ginka-9.9.9.dmg) ;;
*) fail "unexpected image name: $image" ;;
esac
[ -L "$mount/Applications" ] || fail "the image offers an Applications link"
app_only=$(sh "$root/scripts/package-macos" --bin-dir "$work/built" --out-dir "$work/app-only" --version 9.9.9 --no-dmg)
[ -x "$app_only/Contents/MacOS/ginka-app" ] || fail "--no-dmg leaves the .app"
echo "ok"
